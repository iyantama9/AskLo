# Local host ports (container-to-container ports stay unchanged)
APP_PORT=8888
BACKEND_PORT=14001
POSTGRES_PORT=55432
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
PUBLIC_BASE_URL=http://localhost:8888
POSTGRES_VOLUME_NAME=getai_docker_postgres_data
MINIO_VOLUME_NAME=getai_docker_minio_data

# Database Configuration
POSTGRES_DB=getai
POSTGRES_USER=getai_user
POSTGRES_PASSWORD=change_this_database_password

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_BUCKET=asklo-files

# JWT & Session Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_SECRET=your_session_secret_here_change_in_production

# AI API Configuration
AI_BASE_URL=https://routers.iyantama.tech/v1
AI_API_KEY=your_ai_api_key_here

# Usage Quotas (per 24 hours)
QUOTA_AI_REQUESTS_PER_DAY=100
QUOTA_BROWSE_REQUESTS_PER_DAY=30
QUOTA_IMAGE_GENERATIONS_PER_DAY=20
QUOTA_UPLOADS_PER_DAY=50
QUOTA_UPLOAD_BYTES_PER_DAY=20971520
